# Starting password for the home domain only, until that domain saves its own.
# Sent as: Authorization: Bearer <password>
# Other domains choose a password on /setup. Once a domain saves a password, this one stops working there.
ADMIN_PASSWORD=change-me

# Home domain. The starting password works only here, and the existing site data is copied onto this host.
# On this server set it to potatogamer.uk. Another copy of the site should use its own domain.
PRIMARY_HOST=

# Discord bot token. Server-only. Never prefix this with VITE_.
# Loads avatars, and reads status for people Lanyard does not know when the bot shares a server with them.
# Create an application at https://discord.com/developers/applications, then Bot → Reset Token.
# Enable the Presence Intent under Privileged Gateway Intents. The Server Members Intent is not required.
# On Vercel, store it as a Secret for Production and Preview.
DISCORD_BOT_TOKEN=

# Optional. Server ID to read statuses from. Leave empty to check every server the bot is in.
DISCORD_GUILD_ID=

# TMDB key for the admin media search. Server-only. Never prefix this with VITE_.
# The chosen poster is saved in site config, so the homepage does not call TMDB.
# Create one at https://www.themoviedb.org/settings/api — the v3 API key or the v4 read token both work.
# On Vercel, store it as a Secret for Production and Preview.
TMDB_API_KEY=

# SteamGridDB key for featuring games. Server-only. Never prefix this with VITE_.
# Create one at https://www.steamgriddb.com/profile/preferences/api
# The chosen grid and hero are saved in site config, so the homepage does not call SteamGridDB.
# On Vercel, store it as a Secret for Production and Preview.
STEAMGRIDDB_API_KEY=

# Upstash Redis. Either pair works. Leave both empty for in-memory local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
