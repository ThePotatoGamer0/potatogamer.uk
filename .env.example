# Password checked by /api/config and /api/guestbook delete.
# Sent as: Authorization: Bearer <password>
ADMIN_PASSWORD=change-me

# Discord bot token. Server-only. Loads avatars for people who are not on Lanyard.
# Create an application at https://discord.com/developers/applications, then Bot → Reset Token.
# No privileged intents and no server invite are required. Never prefix this with VITE_.
# On Vercel, store it as a Secret for Production and Preview.
DISCORD_BOT_TOKEN=

# TMDB key for the admin media search. Server-only. Never prefix this with VITE_.
# The chosen poster is saved in site config, so the homepage does not call TMDB.
# Create one at https://www.themoviedb.org/settings/api — the v3 API key or the v4 read token both work.
# On Vercel, store it as a Secret for Production and Preview.
TMDB_API_KEY=

# SteamGridDB key for featuring games. Server-only. Never prefix this with VITE_.
# Create one at https://www.steamgriddb.com/profile/preferences/api
# The chosen grid and hero are saved in site config, so the homepage does not call SteamGridDB.
# On Vercel, store it as a Secret for Production and Preview.
STEAMGRIDDB_API_KEY=

# Upstash Redis. Either pair works. Leave both empty for in-memory local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
