{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/profile/", "destination": "/profile", "permanent": true },
    { "source": "/activity/", "destination": "/activity", "permanent": true },
    { "source": "/links/", "destination": "/links", "permanent": true },
    { "source": "/friends/", "destination": "/friends", "permanent": true },
    { "source": "/interests/", "destination": "/interests", "permanent": true },
    { "source": "/media/", "destination": "/media", "permanent": true },
    { "source": "/setup/", "destination": "/setup", "permanent": true },
    { "source": "/homelab/", "destination": "/homelab", "permanent": true },
    { "source": "/guestbook/", "destination": "/guestbook", "permanent": true }
  ],
  "functions": {
    "api/og.ts": {
      "includeFiles": "{api/_lib/Geist-Regular.ttf,node_modules/@jsquash/webp/codec/dec/webp_dec.wasm}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
